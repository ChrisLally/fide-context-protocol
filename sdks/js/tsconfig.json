{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],  // DOM needed for crypto.subtle, TextEncoder
    "types": []                // drop node-specific types, keep it environment agnostic
  },
  "include": ["src/**/*.ts"]
}