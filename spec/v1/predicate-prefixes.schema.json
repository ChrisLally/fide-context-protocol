{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fide.work/fcp/spec/v1/predicate-prefixes.schema.json",
  "title": "FCP Predicate Prefixes v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespaceUrl", "specVersion", "specDate", "prefixes", "defaultPredicatePrefixes"],
  "properties": {
    "namespaceUrl": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "specVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "specDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "prefixes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9]*$": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.+[\\\\/#]$"
        }
      },
      "additionalProperties": false
    },
    "defaultPredicatePrefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*$"
      },
      "uniqueItems": true
    }
  }
}
